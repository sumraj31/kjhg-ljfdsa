# ==============================================================================
# ANMOL KALA — ENVIRONMENT VARIABLES GUIDE FOR RAILWAY & SUPABASE
# ==============================================================================

# 1. DATABASE_URL (Required for live Supabase PostgreSQL connection)
# WHERE TO FIND IT:
# - Log into https://supabase.com/dashboard
# - Open your project -> Click gear icon (Project Settings) on bottom-left sidebar
# - Go to "Database" -> Scroll down to "Connection String" -> Select "URI" tab
# - Mode: "Session" (port 5432) or "Transaction" (port 6543)
# - Replace [YOUR-PASSWORD] with the database password you set when creating the Supabase project
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. NODE_ENV & NIXPACKS_NODE_VERSION (Required for Railway)
# WHERE TO SET: Railway Dashboard -> Your Service -> Variables -> Add Variable
NODE_ENV=production
NIXPACKS_NODE_VERSION=22

# 3. PORT (Automatically set by Railway - DO NOT OVERRIDE on Railway)
# Railway will automatically assign and inject this port at runtime.
PORT=3000

# 4. ADMIN_USERNAME (Admin login email)
ADMIN_USERNAME=anmolkala.in@gmail.com

# 5. ADMIN_PASSWORD (Admin login password)
# Set your desired password here (default fallback is mnbvcxz12)
ADMIN_PASSWORD=mnbvcxz12

# 6. SESSION_SECRET (Secret key used for HMAC session tokens)
# Any secure random string (minimum 32 characters)
SESSION_SECRET=anmolkala-production-secret-session-key-2026-secure

# 7. SUPABASE_URL & SUPABASE_KEY (Optional - only needed if using Supabase Storage buckets)
# WHERE TO FIND IT: Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]