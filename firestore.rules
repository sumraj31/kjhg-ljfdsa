rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public catalog products - visible in real-time to everyone worldwide
    match /store_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Public catalog categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Media library
    match /product_media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // System status & ping
    match /status/{statusId} {
      allow read, write: if true;
    }
  }
}
