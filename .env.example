# -----------------------------------------------------------------------------
# ANMOL KALA — ENVIRONMENT CONFIGURATION (RAILWAY & SUPABASE)
# -----------------------------------------------------------------------------
# Note: In Railway, configure these variables under Service > Variables.
# NEVER commit actual secrets, tokens, or production passwords to source control.

# Server Port (Railway automatically injects PORT; default is 3000)
PORT=3000

# Node Environment ('production' on Railway live deployment, 'development' locally)
NODE_ENV=production

# -----------------------------------------------------------------------------
# DATABASE — SUPABASE POSTGRESQL (AUTHORITATIVE)
# -----------------------------------------------------------------------------
# Primary Supabase connection string. Use either Session Pooler (port 5432)
# or Transaction Pooler (port 6543) from Supabase Project Settings > Database.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional alternative connection aliases supported by the backend:
# SUPABASE_DB_URL=
# POSTGRES_URL=

# Optional Direct Cloud SQL credentials (if utilizing GCP Cloud SQL alongside Supabase):
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=

# -----------------------------------------------------------------------------
# ADMIN AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Admin dashboard login credentials (footer 'A' icon at anmolkala.in)
ADMIN_USERNAME=anmolkala.in@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Cryptographic secret for signing admin session tokens (min 32 random characters)
SESSION_SECRET=your_32_character_random_cryptographic_secret_here

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------
# Firebase Client API key (if leveraging Firestore real-time client sync)
FIREBASE_API_KEY=