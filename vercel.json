{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|products/|products.json|logo.png|robots.txt|sitemap.xml|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}